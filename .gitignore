# Monorepo ignore rules for Dev-Sketch

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
.next/
**/.next/
out/
**/out/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
**/config.env

# Local tooling/editor
.vercel/
.clerk/
.DS_Store
*.pem

# Local app config (contains environment-specific endpoints)
frontend/config.ts
